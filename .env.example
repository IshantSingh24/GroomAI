# GroomAI Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your actual values.
# The .env file is git-ignored and must NEVER be committed.
#
#   cp .env.example .env
#
# ─────────────────────────────────────────────────────────────────────────────

# ── OpenAI ───────────────────────────────────────────────────────────────────
# Your OpenAI API key. Required for the AI agents, embeddings, and vision.
OPENAI_API_KEY=sk-...

# ── JWT Authentication ────────────────────────────────────────────────────────
# Secret used to sign and verify JWT tokens. Use a long random string.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-to-a-long-random-secret

# ── Database ──────────────────────────────────────────────────────────────────
# LOCAL DOCKER DEVELOPMENT:
#   docker-compose.yml sets DATABASE_URL=postgresql://groomai:groomai@db:5432/groomai
#   automatically, so you do NOT need to set it here for local Docker use.
#
# NON-DOCKER local development (e.g. running uvicorn directly):
#   Uncomment and set this to your local PostgreSQL connection string.
# DATABASE_URL=postgresql://groomai:groomai@localhost:5432/groomai
#
# PRODUCTION (Render):
#   Render injects DATABASE_URL automatically from the linked database.
#   Do not set it here.
