{"id":"style-concise","category":"style","priority":"P1","tags":["style","format","no-search"],"turns":["Explain what niacinamide does and how to use it."],"fixtures":{"user_id":"rohan@example.com","date":"2026-10-26"},"expected":{"tools":{"must_not_call":["serper_search"],"max_calls":2},"output":{"must_contain":["niacinamide"],"must_match":["(?m)^(#{1,3} |[-*] |\\d+\\. )"],"require_markdown_structure":true,"max_words":250,"max_emojis":5},"judge":{"name":"style","criteria":["scannable","calm_tone"]}},"trials":1,"cost_cap_usd":0.01,"notes":"No tool requirement; this is a knowledge answer. Caps length and emoji density."}
