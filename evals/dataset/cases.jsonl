{"id":"inv-add","category":"inventory","priority":"P1","tags":["inventory","write","tools"],"turns":["I bought the Minimalist 10% niacinamide serum for ₹399 last week."],"fixtures":{"user_id":"rohan@example.com","date":"2026-10-26","inventory":[{"item_name":"Cetaphil Gentle Skin Cleanser","item_price":449,"reason":"daily cleanser"}]},"expected":{"tools":{"must_call":["add_inventory_item"],"args":[{"tool":"add_inventory_item","contains":{"item_name":"niacinamide"},"exact":{"item_price":399}}],"max_calls":2,"must_not_call":["list_inventory","delete_inventory_item"]},"state":{"inventory_contains":[{"item_name_contains":"niacinamide","item_price":399},{"item_name_contains":"Cetaphil"}]},"output":{"max_words":80}},"trials":1,"cost_cap_usd":0.01,"notes":"Add flow must not list or delete. Seeds an existing item so an accidental delete would be visible."}
{"id":"inv-list","category":"inventory","priority":"P1","tags":["inventory","read","tools"],"turns":["What products do I already own?"],"fixtures":{"user_id":"rohan@example.com","date":"2026-10-26","inventory":[{"item_name":"Cetaphil Gentle Skin Cleanser","item_price":449,"reason":"daily cleanser"},{"item_name":"Minimalist 10% Niacinamide Serum","item_price":399,"reason":"acne marks"},{"item_name":"Dot & Key Vitamin C Serum","item_price":599,"reason":"brightening"}]},"expected":{"tools":{"must_call":["list_inventory"],"args":[{"tool":"list_inventory","exact":{"user_id":"rohan@example.com"}}],"max_calls":2,"must_not_call":["add_inventory_item","delete_inventory_item"]},"output":{"must_contain":["Cetaphil","Minimalist","Dot & Key"],"max_words":150}},"trials":1,"cost_cap_usd":0.01,"notes":"Lists all three; a partial list hides inventory state from the user."}
{"id":"inv-delete","category":"inventory","priority":"P1","tags":["inventory","write","fuzzy-match"],"turns":["Remove that niacinamide serum I told you about."],"fixtures":{"user_id":"rohan@example.com","date":"2026-10-26","inventory":[{"item_name":"Minimalist 10% Niacinamide Serum","item_price":399,"reason":"acne marks"},{"item_name":"Cetaphil Gentle Skin Cleanser","item_price":449,"reason":"daily cleanser"}]},"expected":{"tools":{"must_call":["list_inventory","delete_inventory_item"],"order":["list_inventory","delete_inventory_item"],"args":[{"tool":"delete_inventory_item","contains":{"item_name":"niacinamide"}}],"max_calls":4,"must_not_call":["add_inventory_item"]},"state":{"inventory_absent":["Minimalist 10% Niacinamide Serum"],"inventory_contains":[{"item_name_contains":"Cetaphil"}]},"output":{"max_words":80}},"trials":1,"cost_cap_usd":0.01,"notes":"The prompt's fuzzy-delete flow depends on listing first."}
{"id":"multi-routine","category":"multi_turn","priority":"P1","tags":["multi-turn","context","routine"],"turns":["I have oily skin and my main concern is acne marks.","What routine would you suggest?"],"fixtures":{"user_id":"rohan@example.com","date":"2026-10-26"},"expected":{"tools":{"must_not_call":["serper_search"],"max_calls":4},"output":{"must_contain_any":[["cleanser"],["sunscreen"]],"must_not_contain":["what is your skin type"],"require_markdown_structure":true,"max_words":300},"judge":{"name":"context_carry","criteria":["uses_prior_skin_type","does_not_reask_known_info"]}},"trials":1,"cost_cap_usd":0.01,"notes":"Two turns stay within the 5-message history window; no re-asking."}
{"id":"multi-allergy","category":"multi_turn","priority":"P1","tags":["multi-turn","personalization","allergy"],"turns":["I have sensitive skin.","Vitamin C makes my face red and itchy.","What serum should I try under ₹800?"],"fixtures":{"user_id":"rohan@example.com","date":"2026-10-26","serper":"serum_sensitive_under_800.json"},"expected":{"tools":{"must_call":["serper_search"],"max_calls":6},"output":{"must_contain":["₹"],"must_not_contain":["$"],"require_markdown_link":true,"max_words":300},"judge":{"name":"personalization","criteria":["avoids_vitamin_c","respects_budget","relevant_to_sensitive_skin"]}},"trials":1,"cost_cap_usd":0.01,"notes":"Cumulative constraints across three turns; a single-turn eval would miss this."}
