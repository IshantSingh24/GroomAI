{"id":"rec-empty","category":"recommendation","priority":"P1","tags":["recommendation","grounding","hallucination"],"turns":["Find me a cruelty-free retinol under ₹300."],"fixtures":{"user_id":"rohan@example.com","date":"2026-10-26","serper":"empty_results.json"},"expected":{"tools":{"must_call":["serper_search"],"max_calls":4},"output":{"must_not_contain":["$"],"max_words":200},"judge":{"name":"recommendation_grounding","criteria":["does_not_invent_products","states_no_results_or_asks_to_adjust_budget"]}},"trials":1,"cost_cap_usd":0.01,"notes":"Empty Serper results are the cheapest way to catch product hallucination."}
{"id":"rec-owned","category":"recommendation","priority":"P1","tags":["recommendation","inventory","search"],"turns":["I already have Minimalist 10% niacinamide serum. What else should I add for acne marks under ₹700?"],"fixtures":{"user_id":"rohan@example.com","date":"2026-10-26","inventory":[{"item_name":"Minimalist 10% Niacinamide Serum","item_price":399,"reason":"acne marks"}],"serper":"serum_acne_under_1000.json"},"expected":{"tools":{"must_call":["list_inventory","serper_search"],"order":["list_inventory","serper_search"],"max_calls":5,"must_not_call":["delete_inventory_item"]},"output":{"must_contain":["₹"],"must_not_contain":["$"],"require_markdown_link":true,"max_words":300},"judge":{"name":"recommendation_quality","criteria":["does_not_recommend_owned_product","within_budget","relevant_to_acne_marks"]}},"trials":1,"cost_cap_usd":0.01,"notes":"The owned-product check is why list_inventory must run before search."}
{"id":"mem-save-pref","category":"memory","priority":"P1","tags":["memory","preference","tools"],"turns":["I hate anything with fragrance. It breaks me out."],"fixtures":{"user_id":"rohan@example.com","date":"2026-10-26"},"expected":{"tools":{"must_call":["save_memory"],"args":[{"tool":"save_memory","contains":{"text":"fragrance"},"exact":{"category":"preference"}}],"max_calls":2},"state":{"memory_contains":[{"text_contains":"fragrance","category":"preference"}]},"output":{"max_words":80}},"trials":1,"cost_cap_usd":0.01,"notes":"Category is part of the contract; 'general' is a failure."}
{"id":"mem-recall","category":"memory","priority":"P1","tags":["memory","personalization","search"],"turns":["Suggest a moisturizer under ₹600."],"fixtures":{"user_id":"rohan@example.com","date":"2026-10-26","profile":{"skin_type":"dry"},"memory":[{"text":"User hates fragrance in skincare","category":"preference","saved_days_ago":44}],"serper":"moisturizer_dry_under_600.json"},"expected":{"tools":{"must_call":["serper_search"],"max_calls":5},"output":{"must_contain":["₹"],"must_not_contain":["$"],"require_markdown_link":true,"max_words":300},"judge":{"name":"personalization","criteria":["uses_recalled_preference","recommends_fragrance_free","does_not_reask_for_skin_type","uses_dry_skin_context"]}},"trials":1,"cost_cap_usd":0.01,"notes":"Profile has dry skin and memory has a fragrance dislike. Both are preloaded; do not ask for skin type again."}
{"id":"mem-contradiction","category":"memory","priority":"P1","tags":["memory","recency","personalization"],"turns":["What's my skin type?"],"fixtures":{"user_id":"rohan@example.com","date":"2026-10-26","memory":[{"text":"User has oily skin","category":"skin_detail","saved_days_ago":75},{"text":"User's skin has become dry since starting retinol","category":"skin_detail","saved_days_ago":10}]},"expected":{"tools":{"must_call":["recall_memory"],"max_calls":3},"output":{"must_contain":["dry"],"max_words":120},"judge":{"name":"memory_consistency","criteria":["trusts_newest_memory","does_not_assert_oily_as_current"]}},"trials":1,"cost_cap_usd":0.01,"notes":"Newest-wins is a prompt rule and a real personalization failure mode."}
{"id":"mem-category","category":"memory","priority":"P1","tags":["memory","category","skin_detail"],"turns":["My skin is combination — oily T-zone but dry cheeks. I also sweat a lot in Mumbai humidity."],"fixtures":{"user_id":"rohan@example.com","date":"2026-10-26"},"expected":{"tools":{"must_call":["save_memory"],"args":[{"tool":"save_memory","contains":{"text":"combination"},"exact":{"category":"skin_detail"}}],"max_calls":3},"state":{"memory_contains":[{"text_contains":"combination","category":"skin_detail"}]},"output":{"max_words":100}},"trials":1,"cost_cap_usd":0.01,"notes":"Do not collapse skin detail and lifestyle into 'general'."}
{"id":"mem-not-profile","category":"memory","priority":"P1","tags":["memory","profile","separation"],"turns":["My name is Rohan and I'm 24."],"fixtures":{"user_id":"rohan@example.com","date":"2026-10-26"},"expected":{"tools":{"must_call":["update_profile"],"must_not_call":["save_memory"],"args":[{"tool":"update_profile","exact":{"key":"name","value":"Rohan"}},{"tool":"update_profile","exact":{"key":"age","value":"24"}}],"max_calls":4},"state":{"profile":{"name":"Rohan","age":"24"}},"output":{"max_words":80}},"trials":1,"cost_cap_usd":0.01,"notes":"Two facts, two calls: the prompt allows one key per update, not one key per conversation."}
{"id":"prof-explicit","category":"profile","priority":"P1","tags":["profile","explicit","tools"],"turns":["I'm 24."],"fixtures":{"user_id":"rohan@example.com","date":"2026-10-26"},"expected":{"tools":{"must_call":["update_profile"],"args":[{"tool":"update_profile","exact":{"key":"age","value":"24"}}],"max_calls":2},"state":{"profile":{"age":"24"},"profile_absent_keys":["name","gender"]},"output":{"max_words":60}},"trials":1,"cost_cap_usd":0.01,"notes":"No inference of name or gender from a single age statement."}
