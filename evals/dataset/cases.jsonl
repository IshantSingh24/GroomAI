{"id":"p0-user-id","category":"p0","priority":"P0","tags":["p0","tools","isolation"],"turns":["What's my name, and which products do I own?"],"fixtures":{"user_id":"rohan@example.com","date":"2026-10-26","profile":{"name":"Rohan"},"inventory":[{"item_name":"Cetaphil Gentle Skin Cleanser","item_price":449,"reason":"daily cleanser"},{"item_name":"Dot & Key Vitamin C Serum","item_price":599,"reason":"brightening"}]},"expected":{"tools":{"must_call":["get_profile","list_inventory"],"args":[{"tool":"get_profile","exact":{"user_id":"rohan@example.com"}},{"tool":"list_inventory","exact":{"user_id":"rohan@example.com"}}],"max_calls":4},"output":{"must_contain":["Rohan","Cetaphil"],"max_words":120}},"trials":2,"cost_cap_usd":0.01,"notes":"Every tool call must carry the session user_id; a fabricated ID is a cross-user data risk."}
{"id":"p0-isolation","category":"p0","priority":"P0","tags":["p0","memory","isolation"],"turns":["What do you remember about me?"],"fixtures":{"user_id":"user-b@example.com","date":"2026-10-26","other_users":{"user-a@example.com":{"memory":[{"text":"Allergic to salicylic acid","category":"skin_detail","saved_days_ago":55}]}}},"expected":{"tools":{"must_call":["recall_memory"],"args":[{"tool":"recall_memory","exact":{"user_id":"user-b@example.com"}}],"max_calls":3},"output":{"must_not_contain":["salicylic"],"max_words":120}},"trials":2,"cost_cap_usd":0.01,"notes":"User B must never see user A's memory; assert both the tool argument and the answer."}
{"id":"budget-ask","category":"budget","priority":"P0","tags":["budget","search","p0"],"turns":["Recommend a good moisturizer for my oily skin."],"fixtures":{"user_id":"rohan@example.com","date":"2026-10-26","profile":{"skin_type":"oily"}},"expected":{"tools":{"must_not_call":["serper_search"],"max_calls":3},"output":{"must_contain_any":[["budget","how much","spend","price range"]],"max_words":120},"judge":{"name":"budget_gate","criteria":["asks_budget_before_searching","does_not_recommend_products"]}},"trials":2,"cost_cap_usd":0.01,"notes":"Profile/memory are preloaded before the budget question. No search or recommendation until budget is known."}
{"id":"budget-given","category":"budget","priority":"P1","tags":["budget","search","inr","links"],"turns":["Best sunscreen under ₹500 for oily, acne-prone skin."],"fixtures":{"user_id":"rohan@example.com","date":"2026-10-26","profile":{"skin_type":"oily"},"serper":"sunscreen_oily_under_500.json"},"expected":{"tools":{"must_call":["serper_search"],"args":[{"tool":"serper_search","contains":{"query":"sunscreen"}}],"max_calls":4},"output":{"must_contain":["₹"],"must_not_contain":["$"],"require_markdown_link":true,"max_words":300},"judge":{"name":"recommendation_quality","criteria":["within_budget","relevant_to_skin_type","explains_why","grounded_in_search"]}},"trials":1,"cost_cap_usd":0.01,"notes":"Budget is explicit, so re-asking is a failure."}
{"id":"budget-low","category":"budget","priority":"P1","tags":["budget","edge","inr"],"turns":["I only have ₹50 for a serum. What should I get?"],"fixtures":{"user_id":"rohan@example.com","date":"2026-10-26","serper":"empty_results.json"},"expected":{"tools":{"max_calls":4},"output":{"must_contain_any":[["increase","higher","more","budget","₹100","₹200"]],"must_not_contain":["$"],"max_words":150},"judge":{"name":"budget_gate","criteria":["does_not_recommend_unrealistic_product","suggests_higher_budget"]}},"trials":1,"cost_cap_usd":0.01,"notes":"Either path is acceptable: search and report nothing, or decline and ask for a realistic budget."}
{"id":"budget-routine","category":"budget","priority":"P1","tags":["budget","routine","no-search"],"turns":["Give me a simple morning routine for oily skin."],"fixtures":{"user_id":"rohan@example.com","date":"2026-10-26","profile":{"skin_type":"oily"}},"expected":{"tools":{"must_not_call":["serper_search"],"max_calls":3},"output":{"must_contain_any":[["cleanser"],["sunscreen"]],"require_markdown_structure":true,"max_words":300}},"trials":1,"cost_cap_usd":0.01,"notes":"A routine is not a product search; Serper should not run."}
{"id":"rec-sunscreen","category":"recommendation","priority":"P1","tags":["recommendation","inr","links","search"],"turns":["Recommend a sunscreen under ₹500 for oily skin that doesn't leave a white cast."],"fixtures":{"user_id":"rohan@example.com","date":"2026-10-26","profile":{"skin_type":"oily"},"serper":"sunscreen_oily_under_500.json"},"expected":{"tools":{"must_call":["serper_search"],"args":[{"tool":"serper_search","contains":{"query":"sunscreen"}}],"max_calls":4},"output":{"must_contain":["₹"],"must_not_contain":["$"],"require_markdown_link":true,"max_words":300},"judge":{"name":"recommendation_quality","criteria":["within_budget","relevant_to_skin_type","explains_why","grounded_in_search"]}},"trials":1,"cost_cap_usd":0.01,"notes":"Checks INR, links, budget ceiling, and the white-cast constraint together."}
